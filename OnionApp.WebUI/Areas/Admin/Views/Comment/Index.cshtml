@using OnionApp.WebUI.Dtos.CommentDtos
@model List<ResultGetCommentWithBlogDto>

@{
    ViewData["Title"] = "Yorum Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    :root {
        --primary: #6366f1;
        --primary-light: #eef2ff;
        --danger: #ef4444;
        --danger-light: #fef2f2;
        --success: #10b981;
        --dark: #0f172a;
        --gray: #64748b;
        --surface: #ffffff;
        --border: #e2e8f0;
        --bg: #f8fafc;
    }

    body {
        background: var(--bg);
    }

    .comment-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 28px;
        padding: 42px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(79,70,229,.18);
    }

        .comment-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: -90px;
            top: -120px;
        }

        .comment-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -50px;
            bottom: -70px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .page-title {
        color: white;
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .page-subtitle {
        color: rgba(255,255,255,.92);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
        margin-bottom: 0;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 22px;
        padding: 28px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
        transition: .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .stat-label {
        color: var(--gray);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 38px;
        font-weight: 800;
        color: var(--dark);
        line-height: 1;
    }

    .stat-primary {
        border-left: 5px solid var(--primary);
    }

    .comment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(380px,1fr));
        gap: 24px;
    }

    .comment-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #edf2f7;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
        transition: .25s ease;
        position: relative;
    }

        .comment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(15,23,42,.08);
        }

    .comment-top {
        padding: 24px 24px 18px 24px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .comment-index {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
    }

    .comment-user {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .user-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 800;
    }

    .user-info h4 {
        margin: 0;
        font-size: 17px;
        font-weight: 800;
        color: var(--dark);
    }

    .user-info span {
        color: var(--gray);
        font-size: 13px;
        font-weight: 600;
    }

    .comment-body {
        padding: 24px;
    }

    .comment-text {
        color: #334155;
        line-height: 1.8;
        font-size: 15px;
        margin-bottom: 24px;
    }

    .comment-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .action-btn {
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .action-btn:hover {
            transform: translateY(-2px);
            color: white;
        }

    .btn-remove {
        background: var(--danger-light);
        color: var(--danger);
    }

        .btn-remove:hover {
            background: var(--danger);
        }

    .btn-approve {
        background: rgba(16,185,129,.12);
        color: var(--success);
    }

        .btn-approve:hover {
            background: var(--success);
        }

    .blog-badge {
        background: rgba(255,255,255,.18);
        color: white;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
    }

    @@media(max-width:768px) {

        .comment-header {
            padding: 30px 24px;
        }

        .page-title {
            font-size: 28px;
        }

        .comment-grid {
            grid-template-columns: 1fr;
        }

        .comment-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>

<div class="page-content">
    <div class="container-fluid">

        <div class="comment-header">

            <div class="header-content">

                <h1 class="page-title">
                    Blog Yorum Yönetimi
                </h1>

                <p class="page-subtitle">
                    Bu blog gönderisine yapılan tüm yorumları görüntüleyebilir,
                    yorumları kaldırabilir veya tekrar aktif hale getirebilirsiniz.
                    Kullanıcı etkileşimlerini modern yönetim paneli üzerinden kolayca kontrol edin.
                </p>

                <div class="blog-badge">
                    <i class="mdi mdi-post-outline"></i>
                    Blog ID: @ViewBag.v
                </div>

            </div>

        </div>

        <div class="stats-row">

            <div class="stat-card stat-primary">

                <div class="stat-label">
                    Toplam Yorum Sayısı
                </div>

                <div class="stat-value">
                    @Model.Count
                </div>

            </div>

        </div>

        <div class="comment-grid">

            @foreach (var item in Model)
            {
                count++;

                <div class="comment-card">

                    <div class="comment-top">

                        <div class="comment-user">

                            <div class="user-avatar">
                                @item.Name.Substring(0, 1).ToUpper()
                            </div>

                            <div class="user-info">
                                <h4>@item.Name</h4>
                                <span>Yorum Sahibi</span>
                            </div>

                        </div>

                        <div class="comment-index">
                            @count
                        </div>

                    </div>

                    <div class="comment-body">

                        <div class="comment-text">
                            @item.Description
                        </div>

                        <div class="comment-actions">

                            <a href="#"
                               class="action-btn btn-remove">
                                <i class="mdi mdi-trash-can-outline"></i>
                                Yorumu Kaldır
                            </a>

                            <a href="#"
                               class="action-btn btn-approve">
                                <i class="mdi mdi-check-circle-outline"></i>
                                Aktif Et
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</div>