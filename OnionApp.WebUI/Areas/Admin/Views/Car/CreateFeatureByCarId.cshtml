@using OnionApp.WebUI.Dtos.FeatureDtos
@model List<ResultFeatureDto>

@{
    ViewData["Title"] = "Araca Özellik Ata";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --primary: #6366f1;
        --primary-light: #eef2ff;
        --success: #10b981;
        --success-light: #ecfdf5;
        --dark: #0f172a;
        --gray: #64748b;
        --border: #e2e8f0;
        --surface: #ffffff;
        --bg: #f8fafc;
    }

    body {
        background: var(--bg);
    }

    .feature-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 30px;
        padding: 42px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(79,70,229,.18);
    }

        .feature-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -120px;
            right: -90px;
        }

        .feature-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -50px;
            bottom: -70px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .page-title {
        color: white;
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .page-subtitle {
        color: rgba(255,255,255,.92);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
        margin-bottom: 0;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 24px;
        padding: 28px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
        transition: .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .stat-primary {
        border-left: 5px solid var(--primary);
    }

    .stat-label {
        color: var(--gray);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 38px;
        font-weight: 800;
        color: var(--dark);
        line-height: 1;
    }

    .feature-card {
        background: white;
        border-radius: 30px;
        border: 1px solid #edf2f7;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
    }

    .feature-card-header {
        padding: 28px 32px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .feature-card-title {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
    }

    .feature-badge {
        background: var(--primary-light);
        color: var(--primary);
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .feature-form {
        padding: 32px;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 18px;
    }

    .feature-item {
        position: relative;
    }

    .feature-checkbox {
        display: none;
    }

    .feature-label {
        width: 100%;
        background: #fff;
        border: 1px solid #edf2f7;
        border-radius: 22px;
        padding: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: .25s ease;
        box-shadow: 0 4px 14px rgba(15,23,42,.03);
    }

        .feature-label:hover {
            transform: translateY(-3px);
            border-color: #dbe4ff;
            box-shadow: 0 12px 24px rgba(15,23,42,.06);
        }

    .feature-checkbox:checked + .feature-label {
        background: var(--success-light);
        border-color: #bbf7d0;
    }

    .feature-info {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .feature-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--dark);
    }

    .feature-desc {
        font-size: 13px;
        color: var(--gray);
        font-weight: 600;
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        transition: .25s ease;
    }

    .feature-checkbox:checked + .feature-label .feature-icon {
        background: var(--success);
        color: white;
    }

    .submit-area {
        margin-top: 35px;
        display: flex;
        justify-content: flex-end;
    }

    .submit-btn {
        border: none;
        border-radius: 18px;
        padding: 15px 28px;
        font-size: 15px;
        font-weight: 700;
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: white;
        transition: .25s ease;
        box-shadow: 0 10px 25px rgba(99,102,241,.20);
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(99,102,241,.28);
        }

    @@media(max-width:768px) {

        .feature-header {
            padding: 30px 24px;
        }

        .page-title {
            font-size: 30px;
        }

        .feature-form {
            padding: 24px;
        }

        .feature-card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .submit-area {
            justify-content: stretch;
        }

        .submit-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="page-content">
    <div class="container-fluid">

        <div class="feature-header">

            <div class="header-content">

                <h1 class="page-title">
                    Araç Özellik Atama
                </h1>

                <p class="page-subtitle">
                    Araç için kullanılabilir özellikleri seçebilir ve araç detay
                    sayfasında görüntülenecek donanım bilgilerini kolayca yönetebilirsiniz.
                    Seçilen özellikler kullanıcı tarafında aktif olarak gösterilecektir.
                </p>

            </div>

        </div>

        <div class="stats-row">

            <div class="stat-card stat-primary">

                <div class="stat-label">
                    Toplam Özellik Sayısı
                </div>

                <div class="stat-value">
                    @Model.Count
                </div>

            </div>

        </div>

        <div class="feature-card">

            <div class="feature-card-header">

                <h3 class="feature-card-title">
                    Özellik Seçim Listesi
                </h3>

                <span class="feature-badge">
                    @Model.Count Özellik
                </span>

            </div>

            <form method="post" class="feature-form">

                <div class="feature-grid">

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="feature-item">

                            <input type="hidden" asp-for="@Model[i].Id" />
                            <input type="hidden" asp-for="@Model[i].Name" />

                            <input type="checkbox"
                                   class="feature-checkbox"
                                   id="feature_@i" />

                            <label class="feature-label"
                                   for="feature_@i">

                                <div class="feature-info">

                                    <span class="feature-name">
                                        @Model[i].Name
                                    </span>

                                    <span class="feature-desc">
                                        Araç özelliğini aktif et
                                    </span>

                                </div>

                                <div class="feature-icon">
                                    <i class="mdi mdi-check"></i>
                                </div>

                            </label>

                        </div>
                    }

                </div>

                <div class="submit-area">

                    <button class="submit-btn">

                        <i class="mdi mdi-car-connected"></i>
                        Özellikleri Ata

                    </button>

                </div>

            </form>

        </div>

    </div>
</div>