@using OnionApp.WebUI.Dtos.AuthorDtos
@model UpdateAuthorDto

@{
    ViewData["Title"] = "Yazar Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --primary: #6366f1;
        --primary-dark: #4f46e5;
        --primary-light: #eef2ff;
        --success: #10b981;
        --dark: #0f172a;
        --gray: #64748b;
        --border: #e2e8f0;
        --surface: #ffffff;
        --bg: #f8fafc;
    }

    body {
        background: var(--bg);
    }

    .author-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 30px;
        padding: 42px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(79,70,229,.18);
    }

        .author-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -120px;
            right: -90px;
        }

        .author-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -50px;
            bottom: -70px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .page-title {
        color: white;
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .page-subtitle {
        color: rgba(255,255,255,.92);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
        margin-bottom: 0;
    }

    .form-card {
        background: white;
        border-radius: 30px;
        border: 1px solid #edf2f7;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
    }

    .form-card-header {
        padding: 28px 32px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-card-title {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
    }

    .form-badge {
        background: var(--primary-light);
        color: var(--primary);
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .modern-form {
        padding: 32px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
        gap: 24px;
    }

    .form-group-modern {
        display: flex;
        flex-direction: column;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-label-modern {
        font-size: 14px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 10px;
    }

    .modern-input,
    .modern-textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 15px 18px;
        font-size: 14px;
        color: var(--dark);
        background: #fff;
        transition: .25s ease;
        outline: none;
        box-shadow: none;
    }

        .modern-input:focus,
        .modern-textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99,102,241,.10);
        }

    .modern-textarea {
        min-height: 140px;
        resize: vertical;
    }

    .input-info {
        margin-top: 8px;
        font-size: 12px;
        color: var(--gray);
    }

    .preview-card {
        margin-top: 30px;
        border: 1px solid #edf2f7;
        border-radius: 24px;
        overflow: hidden;
        background: linear-gradient(135deg,#ffffff,#f8fafc);
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .preview-avatar {
        width: 90px;
        height: 90px;
        border-radius: 24px;
        object-fit: cover;
        border: 4px solid #eef2ff;
        box-shadow: 0 8px 22px rgba(15,23,42,.08);
    }

    .preview-content h4 {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        color: var(--dark);
    }

    .preview-content span {
        display: inline-flex;
        margin-top: 10px;
        background: var(--primary-light);
        color: var(--primary);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .submit-area {
        margin-top: 35px;
        display: flex;
        justify-content: flex-end;
    }

    .submit-btn {
        border: none;
        border-radius: 18px;
        padding: 15px 28px;
        font-size: 15px;
        font-weight: 700;
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: white;
        transition: .25s ease;
        box-shadow: 0 10px 25px rgba(99,102,241,.20);
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(99,102,241,.28);
        }

    @@media(max-width:768px) {

        .author-header {
            padding: 30px 24px;
        }

        .page-title {
            font-size: 30px;
        }

        .modern-form {
            padding: 24px;
        }

        .form-card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .preview-card {
            flex-direction: column;
            text-align: center;
        }

        .submit-area {
            justify-content: stretch;
        }

        .submit-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="page-content">
    <div class="container-fluid">

        <div class="author-header">

            <div class="header-content">

                <h1 class="page-title">
                    Yazar Bilgilerini Güncelle
                </h1>

                <p class="page-subtitle">
                    Yazar profil bilgilerini düzenleyebilir, açıklama metnini güncelleyebilir
                    ve profil görselini değiştirebilirsiniz. Yapılan değişiklikler blog detaylarında
                    ve yazar profil alanlarında otomatik olarak görüntülenecektir.
                </p>

            </div>

        </div>

        <div class="form-card">

            <div class="form-card-header">

                <h3 class="form-card-title">
                    Yazar Düzenleme Formu
                </h3>

                <span class="form-badge">
                    Güncelleme Modu
                </span>

            </div>

            <form method="post" class="modern-form">

                <input type="hidden" asp-for="Id" />

                <div class="form-grid">

                    <div class="form-group-modern">

                        <label class="form-label-modern">
                            Ad Soyad
                        </label>

                        <input type="text"
                               asp-for="Name"
                               class="modern-input"
                               placeholder="Örn: Ahmet Yılmaz" />

                        <span class="input-info">
                            Yazarın tam adını düzenleyebilirsiniz.
                        </span>

                    </div>

                    <div class="form-group-modern">

                        <label class="form-label-modern">
                            Profil Görseli
                        </label>

                        <input type="text"
                               asp-for="ImageUrl"
                               class="modern-input"
                               placeholder="Görsel URL adresi giriniz" />

                        <span class="input-info">
                            Profil fotoğrafı bağlantısını güncelleyin.
                        </span>

                    </div>

                    <div class="form-group-modern full-width">

                        <label class="form-label-modern">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  class="modern-textarea"
                                  placeholder="Yazar hakkında açıklama giriniz"></textarea>

                    </div>

                </div>

                <div class="preview-card">

                    <img src="@Model.ImageUrl"
                         onerror="this.src='https://cdn-icons-png.flaticon.com/512/3135/3135715.png'"
                         class="preview-avatar" />

                    <div class="preview-content">

                        <h4>
                            @Model.Name
                        </h4>

                        <span>
                            İçerik Yazarı Profili
                        </span>

                    </div>

                </div>

                <div class="submit-area">

                    <button type="submit"
                            class="submit-btn">

                        <i class="mdi mdi-content-save-edit-outline"></i>
                        Değişiklikleri Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>
</div>