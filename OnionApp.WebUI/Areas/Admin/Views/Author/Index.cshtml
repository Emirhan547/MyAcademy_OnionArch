@using OnionApp.WebUI.Dtos.AuthorDtos
@model List<ResultAuthorDto>

@{
    ViewData["Title"] = "Yazar Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    :root {
        --primary: #6366f1;
        --primary-light: #eef2ff;
        --success: #10b981;
        --danger: #ef4444;
        --dark: #0f172a;
        --gray: #64748b;
        --border: #e2e8f0;
        --surface: #ffffff;
        --bg: #f8fafc;
    }

    body {
        background: var(--bg);
    }

    .author-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 30px;
        padding: 42px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(79,70,229,.18);
    }

        .author-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -120px;
            right: -90px;
        }

        .author-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -50px;
            bottom: -70px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .page-title {
        color: white;
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .page-subtitle {
        color: rgba(255,255,255,.92);
        font-size: 15px;
        line-height: 1.8;
        max-width: 850px;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 24px;
    }

    .modern-btn {
        border: none;
        border-radius: 16px;
        padding: 13px 22px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: .25s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: white;
        box-shadow: 0 10px 25px rgba(99,102,241,.22);
    }

        .btn-primary-modern:hover {
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 18px 35px rgba(99,102,241,.28);
        }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 24px;
        padding: 28px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
        transition: .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .stat-primary {
        border-left: 5px solid var(--primary);
    }

    .stat-label {
        color: var(--gray);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 38px;
        font-weight: 800;
        color: var(--dark);
        line-height: 1;
    }

    .table-card {
        background: white;
        border-radius: 28px;
        border: 1px solid #edf2f7;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
    }

    .table-header {
        padding: 24px 28px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .table-title {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
    }

    .table-badge {
        background: var(--primary-light);
        color: var(--primary);
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table thead {
            background: #f8fafc;
        }

            .table thead th {
                border: none;
                padding: 18px;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: var(--gray);
                font-weight: 700;
                white-space: nowrap;
            }

        .table tbody tr {
            transition: .2s ease;
            border-bottom: 1px solid #f1f5f9;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }

        .table tbody td {
            padding: 20px 18px;
            border: none;
            vertical-align: middle;
        }

    .author-index {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .author-box {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .author-image {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        object-fit: cover;
        border: 3px solid #eef2ff;
        box-shadow: 0 6px 16px rgba(15,23,42,.08);
    }

    .author-name {
        font-weight: 800;
        color: var(--dark);
        font-size: 15px;
    }

    .author-role {
        color: var(--gray);
        font-size: 13px;
        margin-top: 3px;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .action-btn {
        border: none;
        border-radius: 14px;
        padding: 11px 16px;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
        text-decoration: none;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .action-btn:hover {
            transform: translateY(-2px);
            color: white;
        }

    .btn-delete {
        background: rgba(239,68,68,.12);
        color: #dc2626;
    }

        .btn-delete:hover {
            background: var(--danger);
        }

    .btn-update {
        background: rgba(16,185,129,.12);
        color: #059669;
    }

        .btn-update:hover {
            background: var(--success);
        }

    .btn-blog {
        background: rgba(15,23,42,.08);
        color: var(--dark);
    }

        .btn-blog:hover {
            background: var(--dark);
        }

    @@media(max-width:1200px) {
        .table-responsive {
            overflow-x: auto;
        }

        .action-group {
            min-width: 360px;
        }
    }

    @@media(max-width:768px) {

        .author-header {
            padding: 30px 24px;
        }

        .page-title {
            font-size: 28px;
        }

        .top-actions {
            justify-content: flex-start;
        }

        .table-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }
</style>

<div class="page-content">
    <div class="container-fluid">

        <div class="author-header">

            <div class="header-content">

                <h1 class="page-title">
                    Yazar Yönetim Paneli
                </h1>

                <p class="page-subtitle">
                    Sistemde kayıtlı yazarları görüntüleyebilir, güncelleyebilir veya kaldırabilirsiniz.
                    Yazar girişlerinde bilgilerin eksiksiz ve doğru girilmesi içerik yönetimi açısından önemlidir.
                </p>

            </div>

        </div>

        <div class="top-actions">

            <a href="/Admin/Author/CreateAuthor"
               class="modern-btn btn-primary-modern">

                <i class="mdi mdi-account-plus-outline"></i>
                Yeni Yazar Ekle

            </a>

        </div>

        <div class="stats-row">

            <div class="stat-card stat-primary">

                <div class="stat-label">
                    Toplam Yazar Sayısı
                </div>

                <div class="stat-value">
                    @Model.Count
                </div>

            </div>

        </div>

        <div class="table-card">

            <div class="table-header">

                <h3 class="table-title">
                    Yazar Listesi
                </h3>

                <span class="table-badge">
                    @Model.Count Aktif Yazar
                </span>

            </div>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Yazar Bilgileri</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>

                                <td>
                                    <div class="author-index">
                                        @count
                                    </div>
                                </td>

                                <td>

                                    <div class="author-box">

                                        <img src="@item.ImageUrl"
                                             class="author-image" />

                                        <div>

                                            <div class="author-name">
                                                @item.Name
                                            </div>

                                            <div class="author-role">
                                                İçerik Yazarı
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <div class="action-group">

                                        <a href="/Admin/Author/DeleteAuthor/@item.Id"
                                           class="action-btn btn-delete">

                                            <i class="mdi mdi-trash-can-outline"></i>
                                            Sil

                                        </a>

                                        <a href="/Admin/Author/UpdateAuthor/@item.Id"
                                           class="action-btn btn-update">

                                            <i class="mdi mdi-pencil-outline"></i>
                                            Güncelle

                                        </a>

                                        <a href="/Admin/Author/#/@item.Id"
                                           class="action-btn btn-blog">

                                            <i class="mdi mdi-post-outline"></i>
                                            Blogları

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>