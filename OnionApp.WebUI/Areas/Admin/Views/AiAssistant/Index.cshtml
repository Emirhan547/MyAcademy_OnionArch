@model OnionApp.WebUI.Dtos.AiDtos.AdminContentAiRequestDto
@using OnionApp.WebUI.Base
@using OnionApp.WebUI.Dtos.AiDtos
@{
    ViewData["Title"] = "AI Admin Asistanı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var result = ViewBag.AiResult as BaseResult<AiSuggestionDto>;
    var smartPricingRequest = ViewBag.SmartPricingRequest as SmartPricingAiRequestDto ?? new SmartPricingAiRequestDto();
    var smartPricingResult = ViewBag.SmartPricingResult as BaseResult<SmartPricingDto>;
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0 font-size-18">AI Admin İçerik ve Operasyon Asistanı</h4>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">İçerik İsteği</h5>
                <form method="post" asp-action="Index">
                    <div class="form-group"><label>İçerik Türü</label><input asp-for="ContentType" class="form-control" placeholder="Blog, kampanya, sosyal medya..." /></div>
                    <div class="form-group"><label>Hedef Kitle</label><input asp-for="TargetAudience" class="form-control" placeholder="Aileler, iş seyahati, öğrenciler..." /></div>
                    <div class="form-group"><label>Anahtar Kelimeler</label><input asp-for="Keywords" class="form-control" placeholder="ekonomik araç, havalimanı teslim..." /></div>
                    <div class="form-group"><label>Ton</label><input asp-for="ToneOfVoice" class="form-control" /></div>
                    <button type="submit" class="btn btn-primary">AI Fikir Üret</button>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Smart Pricing (ML.NET)</h5>
                <form method="post" asp-action="SmartPricing">
                    <div class="form-group"><label>Araç Tipi</label><input name="CarType" value="@smartPricingRequest.CarType" class="form-control" placeholder="SUV, Sedan, Hatchback..." /></div>
                    <div class="form-group"><label>Sezon</label><input name="Season" value="@smartPricingRequest.Season" class="form-control" placeholder="low / normal / high" /></div>
                    <div class="form-group"><label>Lokasyon</label><input name="Location" value="@smartPricingRequest.Location" class="form-control" placeholder="istanbul, ankara, izmir" /></div>
                    <div class="form-group"><label>KM</label><input name="Km" type="number" value="@smartPricingRequest.Km" class="form-control" /></div>
                    <div class="form-group"><label>Yakıt</label><input name="Fuel" value="@smartPricingRequest.Fuel" class="form-control" placeholder="benzin, dizel, elektrik" /></div>
                    <div class="form-group"><label>Geçmiş Talep Endeksi (0-100)</label><input name="HistoricalDemandIndex" type="number" min="0" max="100" value="@smartPricingRequest.HistoricalDemandIndex" class="form-control" /></div>
                    <button type="submit" class="btn btn-success">Smart Fiyat Öner</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        @if (smartPricingResult?.Data != null)
        {
            <div class="card mb-3 border-success">
                <div class="card-body">
                    <h4>@smartPricingResult.Data.Title</h4>
                    <h3 class="text-success">@smartPricingResult.Data.SuggestedDailyPrice @smartPricingResult.Data.Currency / Gün</h3>
                    <p>@smartPricingResult.Data.Summary</p>
                    <ul class="list-group">
                        @foreach (var factor in smartPricingResult.Data.PriceFactors)
                        {
                            <li class="list-group-item">@factor</li>
                        }
                    </ul>
                </div>
            </div>
        }
        @if (result?.Data != null)
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4>@result.Data.Title</h4>
                        <span class="badge badge-info">@result.Data.Source</span>
                    </div>
                    <p>@result.Data.Summary</p>
                    <ul class="list-group">
                        @foreach (var suggestion in result.Data.Suggestions)
                        {
                            <li class="list-group-item">@suggestion</li>
                        }
                    </ul>
                    <small class="text-warning d-block mt-3">@result.Data.Disclaimer</small>
                </div>
            </div>
        }
        else if (smartPricingResult?.Data == null)
        {
            <div class="alert alert-info">Dashboard metriklerini kullanarak blog, kampanya ve operasyon önerisi üretmek veya ML.NET smart pricing hesaplamak için formu doldurun.</div>
        }
    </div>
</div>