@using OnionApp.WebUI.Dtos.BlogDtos
@model List<ResultAllBlogsWithAuthorDto>

@{
    ViewData["Title"] = "Blog Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    :root {
        --primary: #6366f1;
        --primary-light: #eef2ff;
        --danger: #ef4444;
        --warning: #f59e0b;
        --dark: #0f172a;
        --gray: #64748b;
        --surface: #ffffff;
        --border: #e2e8f0;
        --bg: #f8fafc;
    }

    body {
        background: var(--bg);
    }

    .blog-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 28px;
        padding: 42px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(79, 70, 229, 0.18);
    }

        .blog-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: -90px;
            top: -120px;
        }

        .blog-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: -50px;
            bottom: -70px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .blog-title {
        color: white;
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .blog-subtitle {
        color: rgba(255,255,255,.92);
        font-size: 15px;
        line-height: 1.8;
        max-width: 900px;
        margin-bottom: 0;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 22px;
        padding: 28px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
        transition: .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .stat-label {
        color: var(--gray);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 38px;
        font-weight: 800;
        color: var(--dark);
        line-height: 1;
    }

    .stat-primary {
        border-left: 5px solid var(--primary);
    }

    .table-card {
        background: white;
        border-radius: 26px;
        border: 1px solid #edf2f7;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15,23,42,.05);
    }

    .table-header {
        padding: 24px 28px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .table-title {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
    }

    .table-badge {
        background: var(--primary-light);
        color: var(--primary);
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table thead {
            background: #f8fafc;
        }

            .table thead th {
                border: none;
                padding: 18px;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: var(--gray);
                font-weight: 700;
                white-space: nowrap;
            }

        .table tbody tr {
            transition: .2s ease;
            border-bottom: 1px solid #f1f5f9;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }

        .table tbody td {
            padding: 20px 18px;
            border: none;
            vertical-align: middle;
        }

    .blog-index {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .blog-name {
        font-weight: 700;
        color: var(--dark);
        max-width: 280px;
        line-height: 1.5;
    }

    .author-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f1f5f9;
        color: var(--dark);
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .category-badge {
        display: inline-flex;
        background: #ede9fe;
        color: #7c3aed;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .date-box {
        font-weight: 700;
        color: var(--dark);
        white-space: nowrap;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .action-btn {
        border: none;
        border-radius: 14px;
        padding: 11px 16px;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
        text-decoration: none;
        white-space: nowrap;
    }

        .action-btn:hover {
            transform: translateY(-2px);
            color: white;
        }

    .btn-delete {
        background: rgba(239,68,68,.12);
        color: #dc2626;
    }

        .btn-delete:hover {
            background: #ef4444;
        }

    .btn-open {
        background: rgba(15,23,42,.08);
        color: #0f172a;
    }

        .btn-open:hover {
            background: #0f172a;
        }

    .btn-comment {
        background: rgba(245,158,11,.12);
        color: #d97706;
    }

        .btn-comment:hover {
            background: #f59e0b;
        }

    @@media(max-width:1200px) {
        .table-responsive {
            overflow-x: auto;
        }

        .action-group {
            min-width: 320px;
        }
    }

    @@media(max-width:768px) {
        .blog-header {
            padding: 30px 24px;
        }

        .blog-title {
            font-size: 28px;
        }

        .table-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }
</style>

<div class="page-content">
    <div class="container-fluid">

        <div class="blog-header">
            <div class="header-content">

                <h1 class="blog-title">
                    Blog Yönetim Paneli
                </h1>

                <p class="blog-subtitle">
                    Sistem üzerindeki blog içeriklerini görüntüleyebilir, yorumları inceleyebilir
                    ve içerik yönetimini gerçekleştirebilirsiniz. Yeni blog ekleme işlemleri yalnızca
                    yazar paneli üzerinden yapılmaktadır. Her yazar yalnızca kendi içeriklerini yönetebilir.
                </p>

            </div>
        </div>

        <div class="stats-row">

            <div class="stat-card stat-primary">
                <div class="stat-label">
                    Toplam Blog Sayısı
                </div>

                <div class="stat-value">
                    @Model.Count
                </div>
            </div>

        </div>

        <div class="table-card">

            <div class="table-header">

                <h3 class="table-title">
                    Blog Listesi
                </h3>

                <span class="table-badge">
                    @Model.Count Blog İçeriği
                </span>

            </div>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Yazar</th>
                            <th>Kategori</th>
                            <th>Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>

                                <td>
                                    <div class="blog-index">
                                        @count
                                    </div>
                                </td>

                                <td>
                                    <div class="blog-name">
                                        @item.Title
                                    </div>
                                </td>

                                <td>
                                    <span class="author-badge">
                                        <i class="mdi mdi-account-edit-outline"></i>
                                        @item.AuthorName
                                    </span>
                                </td>

                                <td>
                                    <span class="category-badge">
                                        Kategori #@item.CategoryId
                                    </span>
                                </td>

                                <td>
                                    <div class="date-box">
                                        @Convert.ToDateTime(item.CreatedDate).ToString("dd.MM.yyyy")
                                    </div>
                                </td>

                                <td>

                                    <div class="action-group">

                                        <a href="/Admin/AdminBlog/RemoveBlog/@item.Id"
                                           class="action-btn btn-delete">
                                            <i class="mdi mdi-trash-can-outline"></i>
                                            Sil
                                        </a>

                                        <a href="/Blog/BlogDetail/@item.Id"
                                           class="action-btn btn-open">
                                            <i class="mdi mdi-open-in-new"></i>
                                            Blogu Aç
                                        </a>

                                        <a href="/Admin/Comment/Index/@item.Id"
                                           class="action-btn btn-comment">
                                            <i class="mdi mdi-comment-processing-outline"></i>
                                            Yorumlar
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>