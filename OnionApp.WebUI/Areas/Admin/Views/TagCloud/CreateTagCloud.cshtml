@using OnionApp.WebUI.Dtos.TagCloudDtos
@model List<ResultTagCloudDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="page-content">
    <div class="container-fluid">
        <h4>TagCloud</h4>
        <a class="btn btn-primary" href="/Admin/TagCloud/CreateTagCloud">Yeni</a>
        <table class="table">
            <tr>
                <th>Tag</th>
                <th>BlogId</th>
                <th></th>
            </tr>
            @foreach(var i in Model)
            {
    <tr>
        <td>@i.Title</td>
        <td>@i.BlogId</td>
        <td>
            <a href="/Admin/TagCloud/UpdateTagCloud/@i.Id">Güncelle</a> 
            <a href="/Admin/TagCloud/DeleteTagCloud/@i.Id">Sil</a>
        </td>
        </tr>
}
</table>
</div>
</div>