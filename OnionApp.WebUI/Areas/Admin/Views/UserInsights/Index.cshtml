@model OnionApp.WebUI.Dtos.UserInsightDtos.UserInsightDashboardViewModel
@{
    ViewData["Title"] = "AI Kullanıcı İçgörüleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">AI Kullanıcı İçgörüleri</h4>
    <form method="post" asp-action="TrackDemoEvent" class="mb-0">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="City" />
        <input type="hidden" asp-for="CarSegment" />
        <input type="hidden" asp-for="PickupDate" />
        <input type="hidden" asp-for="ReturnDate" />
        <button class="btn btn-outline-primary btn-sm">Demo Event Gönder</button>
    </form>
</div>

@if (Model.EventStatus is not null)
{
    <div class="alert @(Model.EventStatus == "ok" ? "alert-success" : "alert-danger")">
        Event gönderim durumu: <strong>@Model.EventStatus</strong>
    </div>
}

<form method="get" asp-action="Index" class="card p-3 mb-4">
    <div class="row">
        <div class="col-md-3"><label>Kullanıcı</label><input asp-for="UserId" class="form-control" /></div>
        <div class="col-md-2"><label>Şehir</label><input asp-for="City" class="form-control" /></div>
        <div class="col-md-2"><label>Segment</label><input asp-for="CarSegment" class="form-control" /></div>
        <div class="col-md-2"><label>Alış</label><input asp-for="PickupDate" class="form-control" type="date" /></div>
        <div class="col-md-2"><label>Dönüş</label><input asp-for="ReturnDate" class="form-control" type="date" /></div>
        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100">Getir</button></div>
    </div>
</form>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h5>Sana Özel Araçlar</h5>
            <p class="text-muted">Model: @Model.Recommendation?.ModelVersion | Güven: @Model.Recommendation?.ConfidenceScore</p>
            <ul>
                @foreach (var carId in Model.Recommendation?.SuggestedCarIds ?? [])
                {
                    <li>@carId</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h5>Rezervasyon İptal Riski</h5>
            <p>Risk Skoru: <strong>@Model.ChurnPrediction?.RiskScore</strong></p>
            <p>Segment: <span class="badge badge-warning">@Model.ChurnPrediction?.Segment</span></p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h5>Dinamik Fiyat Tahmini</h5>
            <p>@Model.PriceSuggestion?.City / @Model.PriceSuggestion?.CarSegment</p>
            <p><strong>@Model.PriceSuggestion?.SuggestedMinPrice ₺ - @Model.PriceSuggestion?.SuggestedMaxPrice ₺</strong></p>
            @if (Model.PriceSuggestion?.IsOpportunity == true)
            {
                <span class="badge badge-success">Fırsat Etiketi</span>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h5>Yorum / Sentiment Analizi</h5>
            <p>Pozitif: @Model.Sentiment?.PositiveCount | Negatif: @Model.Sentiment?.NegativeCount | Nötr: @Model.Sentiment?.NeutralCount</p>
            <p class="mb-1">İyileştirme Noktaları:</p>
            <ul>
                @foreach (var topic in Model.Sentiment?.ImprovementTopics ?? [])
                {
                    <li>@topic</li>
                }
            </ul>
        </div>
    </div>
</div>