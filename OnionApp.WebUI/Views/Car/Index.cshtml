@model CarListViewModel
@{
    ViewData["Title"] = "Araçlarımız";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section bg-light pb-0">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-10">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col-lg-5 mb-3 mb-lg-0">
                                <span class="subheading">CarBook AI</span>
                                <h3 class="mb-2">Kararsız kaldıysan araçları birlikte seçelim</h3>
                                <p class="text-muted mb-0">Bu asistan, aşağıdaki gerçek CarBook araç listesini dikkate alarak yolcu sayısı, bütçe, yakıt ve vites tercihine göre sana uygun araç önerisi üretir.</p>
                            </div>
                            <div class="col-lg-7">
                                <form method="post" asp-action="Index" asp-controller="Car">
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label>Kullanım amacı</label>
                                            <input asp-for="AiRequest.TripPurpose" class="form-control" placeholder="Tatil, şehir içi, iş seyahati..." />
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label>Yolcu</label>
                                            <input asp-for="AiRequest.PassengerCount" class="form-control" type="number" min="1" />
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label>Bütçe</label>
                                            <input asp-for="AiRequest.DailyBudget" class="form-control" type="number" step="0.01" />
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-4">
                                            <label>Yakıt</label>
                                            <input asp-for="AiRequest.PreferredFuel" class="form-control" placeholder="Dizel, Elektrik..." />
                                        </div>
                                        <div class="form-group col-md-4">
                                            <label>Vites</label>
                                            <input asp-for="AiRequest.PreferredTransmission" class="form-control" placeholder="Otomatik/Manuel" />
                                        </div>
                                        <div class="form-group col-md-4">
                                            <label>Ek not</label>
                                            <input asp-for="AiRequest.Notes" class="form-control" placeholder="Bagaj, çocuk koltuğu..." />
                                        </div>
                                    </div>
                                    <button class="btn btn-primary py-2 px-4" type="submit">Listeden AI Önerisi Al</button>
                                </form>
                            </div>
                        </div>

                        @if (Model.AiResult?.Data != null)
                        {
                            <div class="alert alert-info mt-4 mb-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>@Model.AiResult.Data.Title</strong>
                                    <small>@Model.AiResult.Data.Source</small>
                                </div>
                                <p class="mb-2 mt-2">@Model.AiResult.Data.Summary</p>
                                <ul class="mb-1">
                                    @foreach (var suggestion in Model.AiResult.Data.Suggestions)
                                    {
                                        <li>@suggestion</li>
                                    }
                                </ul>
                                <small>@Model.AiResult.Data.Disclaimer</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="ftco-section bg-light">
    <div class="container">
        <div class="row">
            @foreach (var item in Model.Cars)
            {
                <div class="col-md-4">
                    <div class="car-wrap rounded ftco-animate">
                        <div class="img rounded d-flex align-items-end" style="background-image: url(@item.CoverImageUrl);">
                        </div>
                        <div class="text">
                            <h2 class="mb-0"><a href="/Car/CarDetail/@item.CarId">@item.Model</a></h2>
                            <div class="d-flex mb-3">
                                <span class="cat">@item.Brand</span>
                                <p class="price ml-auto">@item.Amount <span>/Günlük</span></p>
                            </div>
                            <p class="d-flex mb-0 d-block">
                                <a href="/Reservation/Index/@item.CarId" class="btn btn-primary py-2 mr-1">Hemen Kirala</a>
                                <a href="/Car/CarDetail/@item.CarId" class="btn btn-secondary py-2 ml-1">Detaylar</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>