@model OnionApp.WebUI.Dtos.AiDtos.CarAdvisorAiRequestDto
@{
    ViewData["Title"] = "AI Araç Danışmanı";
    Layout = "~/Views/UILayout/Index.cshtml";
}
<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9">
                <div class="card p-4 shadow-sm">
                    <h3>AI Araç Danışmanı</h3>
                    <p class="text-muted">İhtiyacını yaz, sistem araç envanteriyle birlikte en uygun kiralama önerilerini hazırlasın.</p>
                    <form method="post">
                        <div class="form-group"><label>Kullanım Amacı</label><input asp-for="TripPurpose" class="form-control" placeholder="Şehir içi, tatil, iş seyahati..." /></div>
                        <div class="form-row">
                            <div class="form-group col-md-4"><label>Yolcu Sayısı</label><input asp-for="PassengerCount" class="form-control" type="number" min="1" /></div>
                            <div class="form-group col-md-4"><label>Günlük Bütçe</label><input asp-for="DailyBudget" class="form-control" type="number" step="0.01" /></div>
                            <div class="form-group col-md-4"><label>Vites</label><input asp-for="PreferredTransmission" class="form-control" placeholder="Otomatik/Manuel" /></div>
                        </div>
                        <div class="form-group"><label>Yakıt Tercihi</label><input asp-for="PreferredFuel" class="form-control" placeholder="Benzin, Dizel, Elektrik..." /></div>
                        <div class="form-group"><label>Ek Notlar</label><textarea asp-for="Notes" class="form-control" rows="4"></textarea></div>
                        <button class="btn btn-primary py-3 px-5" type="submit">Öneri Al</button>
                    </form>
                </div>
                @await Html.PartialAsync("_AiResult")
            </div>
        </div>
    </div>
</section>