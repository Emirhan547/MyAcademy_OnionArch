@model OnionApp.WebUI.Dtos.AiDtos.ReservationAssistantAiRequestDto
@{
    ViewData["Title"] = "AI Rezervasyon Asistanı";
    Layout = "~/Views/UILayout/Index.cshtml";
}
<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9">
                <div class="card p-4 shadow-sm">
                    <h3>AI Rezervasyon Asistanı</h3>
                    <p class="text-muted">Teslim alma/iade bilgilerine göre kontrol listesi ve seyahat hazırlık planı üretir.</p>
                    <form method="post">
                        <div class="form-row">
                            <div class="form-group col-md-6"><label>Alış Lokasyonu</label><input asp-for="PickUpLocation" class="form-control" /></div>
                            <div class="form-group col-md-6"><label>İade Lokasyonu</label><input asp-for="DropOffLocation" class="form-control" /></div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6"><label>Alış Tarihi</label><input asp-for="PickUpDate" class="form-control" type="date" /></div>
                            <div class="form-group col-md-6"><label>İade Tarihi</label><input asp-for="ReturnDate" class="form-control" type="date" /></div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6"><label>Yaş</label><input asp-for="Age" class="form-control" type="number" /></div>
                            <div class="form-group col-md-6"><label>Ehliyet Yılı</label><input asp-for="DriverLicenseYear" class="form-control" type="number" /></div>
                        </div>
                        <div class="form-group"><label>Seyahat Notu</label><textarea asp-for="TravelNotes" class="form-control" rows="4"></textarea></div>
                        <button class="btn btn-primary py-3 px-5" type="submit">Plan Oluştur</button>
                    </form>
                </div>
                @await Html.PartialAsync("_AiResult")
            </div>
        </div>
    </div>
</section>