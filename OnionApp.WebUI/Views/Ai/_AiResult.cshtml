@using OnionApp.WebUI.Base
@using OnionApp.WebUI.Dtos.AiDtos
@{
    var result = ViewBag.AiResult as BaseResult<AiSuggestionDto>;
}
@if (result?.Data != null)
{
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="mb-0">@result.Data.Title</h4>
                <span class="badge badge-info">@result.Data.Source</span>
            </div>
            <p class="text-muted">@result.Data.Summary</p>
            <ul class="list-group list-group-flush">
                @foreach (var suggestion in result.Data.Suggestions)
                {
                    <li class="list-group-item">@suggestion</li>
                }
            </ul>
            <small class="text-warning d-block mt-3">@result.Data.Disclaimer</small>
        </div>
    </div>
}
else if (result?.Errors?.Any() == true)
{
    <div class="alert alert-danger mt-4">@result.Errors.First().ErrorMessage</div>
}