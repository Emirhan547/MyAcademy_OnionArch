@model ReservationFormViewModel
@using Markdig
@{
    ViewData["Title"] = "Rezervasyon";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<style>
    .reservation-wrapper {
        background: #f4f7fb;
        padding: 60px 0;
    }

    .reservation-card {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(10px);
        border-radius: 28px;
        padding: 45px;
        box-shadow: 0 15px 40px rgba(0,0,0,.08);
        border: 1px solid rgba(255,255,255,.3);
    }

    .reservation-title {
        font-size: 34px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 10px;
    }

    .reservation-subtitle {
        color: #6b7280;
        margin-bottom: 35px;
        font-size: 15px;
    }

    .modern-input {
        border-radius: 16px !important;
        border: 1px solid #e5e7eb !important;
        height: 58px;
        padding-left: 20px !important;
        font-size: 15px;
        transition: .3s ease;
        box-shadow: none !important;
    }

    .modern-input:focus {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 4px rgba(79,70,229,.12) !important;
    }

    textarea.modern-input {
        height: 140px !important;
        padding-top: 15px !important;
    }

    .input-label {
        font-weight: 600;
        margin-bottom: 10px;
        color: #111827;
    }

    .ai-card {
        background: linear-gradient(135deg,#111827,#1f2937);
        color: white;
        border-radius: 24px;
        padding: 30px;
        margin-top: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,.18);
    }

    .ai-badge {
        background: rgba(255,255,255,.15);
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
    }

    .ai-mini-box {
        background: rgba(255,255,255,.08);
        border-radius: 18px;
        padding: 18px;
        height: 100%;
    }

    .ai-mini-box small {
        color: #cbd5e1;
        display: block;
        margin-bottom: 8px;
    }

    .ai-mini-box strong {
        color: white;
    }

    .suggestion-item {
        background: rgba(255,255,255,.08);
        border: none;
        border-radius: 14px;
        margin-bottom: 10px;
        color: white;
        padding: 14px 16px;
    }

    .btn-modern-primary {
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
        border: none;
        border-radius: 16px;
        padding: 16px 34px;
        font-weight: 600;
        color: white;
        transition: .3s;
    }

    .btn-modern-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(79,70,229,.3);
        color: white;
    }

    .btn-modern-outline {
        border: 2px solid #4f46e5;
        border-radius: 16px;
        padding: 14px 34px;
        font-weight: 600;
        color: #4f46e5;
        background: white;
        transition: .3s;
    }

    .btn-modern-outline:hover {
        background: #4f46e5;
        color: white;
    }

    .section-divider {
        margin: 35px 0;
        border-top: 1px solid #e5e7eb;
    }
</style>

<div class="reservation-wrapper">
    <div class="container">
        <div class="reservation-card">

            <h1 class="reservation-title">
                Araç Rezervasyonu
            </h1>

            <p class="reservation-subtitle">
                Aracınızı hızlıca rezerve edin, AI destekli ön kontrol ile eksik bilgileri ve operasyon risklerini önceden analiz edin.
            </p>

            <form method="post">

                <input type="hidden" asp-for="Reservation.CarId">

                <div class="row">

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Adınız</label>
                        <input asp-for="Reservation.Name" class="form-control modern-input" placeholder="Emirhan">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Soyadınız</label>
                        <input asp-for="Reservation.Surname" class="form-control modern-input" placeholder="Hacıoğlu">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Mail Adresi</label>
                        <input asp-for="Reservation.Email" class="form-control modern-input" placeholder="ornek@mail.com">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Telefon</label>
                        <input asp-for="Reservation.Phone" class="form-control modern-input" placeholder="+90 5xx xxx xx xx">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Teslim Alma Lokasyonu</label>
                        @Html.DropDownListFor(x => x.Reservation.PickUpLocationId, Model.Locations,
                                 "Lokasyon seçin",
                                 new { @class = "form-control modern-input" })
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Teslim Etme Lokasyonu</label>
                        @Html.DropDownListFor(x => x.Reservation.DropOffLocationId, Model.Locations,
                                 "Lokasyon seçin",
                                 new { @class = "form-control modern-input" })
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Alış Tarihi</label>
                        <input type="date" asp-for="Reservation.PickUpDate" class="form-control modern-input">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">İade Tarihi</label>
                        <input type="date" asp-for="Reservation.ReturnDate" class="form-control modern-input">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Yaş</label>
                        <input asp-for="Reservation.Age" class="form-control modern-input" placeholder="25">
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="input-label">Ehliyet Yılı</label>
                        <input asp-for="Reservation.DriverLicenseYear" class="form-control modern-input" placeholder="5">
                    </div>

                    <div class="col-md-12 mb-4">
                        <label class="input-label">Ek Notlar</label>
                        <textarea asp-for="Reservation.Description"
                                  class="form-control modern-input"
                                  placeholder="Eklemek istediğiniz notlar..."></textarea>
                    </div>

                </div>

                @if (Model.AiResult?.Data != null)
                {
                    <div class="ai-card">

                        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                            <div>
                                <h3 class="mb-2">@Model.AiResult.Data.Title</h3>
                                <p class="mb-0 text-light">
                                    Rezervasyon AI tarafından analiz edildi.
                                </p>
                            </div>

                            <span class="ai-badge">
                                @Model.AiResult.Data.Source
                            </span>
                        </div>

                        <div class="row mb-4">

                            <div class="col-md-3 mb-3">
                                <div class="ai-mini-box">
                                    <small>Tarih Kontrolü</small>
                                    <strong>Kontrol Edildi</strong>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="ai-mini-box">
                                    <small>Lokasyon</small>
                                    <strong>Doğrulandı</strong>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="ai-mini-box">
                                    <small>Ehliyet / Yaş</small>
                                    <strong>Analiz Edildi</strong>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="ai-mini-box">
                                    <small>AI Risk Skoru</small>
                                    <strong>Düşük Risk</strong>
                                </div>
                            </div>

                        </div>

                        <div class="mb-4">
                            @Html.Raw(Markdown.ToHtml(Model.AiResult.Data.Summary ?? ""))
                        </div>

                        @foreach (var suggestion in Model.AiResult.Data.Suggestions)
                        {
                            <div class="suggestion-item">
                                @Html.Raw(Markdown.ToHtml(suggestion ?? ""))
                            </div>
                        }

                        <small class="d-block mt-3 text-warning">
                            @Model.AiResult.Data.Disclaimer
                        </small>

                    </div>
                }

                <div class="section-divider"></div>

                <div class="d-flex flex-wrap gap-3">

                    <button type="submit"
                            name="submitAction"
                            value="create"
                            class="btn-modern-primary mr-3">
                        Rezervasyonu Tamamla
                    </button>

                    <button type="submit"
                            name="submitAction"
                            value="ai-check"
                            class="btn-modern-outline">
                        AI Ön Kontrol Yap
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>