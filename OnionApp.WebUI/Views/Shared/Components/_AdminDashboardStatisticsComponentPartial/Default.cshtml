@using OnionApp.WebUI.Dtos.DashboardStatsDtos
@model DashboardStatsDto

<div class="row dashboard-spacing mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-primary">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h6 class="text-white mb-0">Toplam Araç</h6>
                    <span class="badge bg-light text-dark">Aktif</span>
                </div>

                <h2 class="text-white fw-bold mb-3">
                    @Model.CarCount
                </h2>

                <div class="progress" style="height:6px;">
                    <div class="progress-bar bg-light"
                         style="width:@ViewBag.CarRandom%">
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-success">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h6 class="text-white mb-0">Lokasyon</h6>
                    <span class="badge bg-light text-dark">Mevcut</span>
                </div>

                <h2 class="text-white fw-bold mb-3">
                    @Model.LocationCount
                </h2>

                <div class="progress" style="height:6px;">
                    <div class="progress-bar bg-light"
                         style="width:@ViewBag.LocationRandom%">
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-warning">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h6 class="text-white mb-0">Toplam Marka</h6>
                    <span class="badge bg-light text-dark">Portföy</span>
                </div>

                <h2 class="text-white fw-bold mb-3">
                    @Model.BrandCount
                </h2>

                <div class="progress" style="height:6px;">
                    <div class="progress-bar bg-light"
                         style="width:@ViewBag.BrandRandom%">
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-info">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h6 class="text-white mb-0">Günlük Ortalama</h6>
                    <span class="badge bg-light text-dark">Ücret</span>
                </div>

                <h2 class="text-white fw-bold mb-3">
                    ₺ @Model.AvgDaily
                </h2>

                <div class="progress" style="height:6px;">
                    <div class="progress-bar bg-light"
                         style="width:@ViewBag.AvgDailyRandom%">
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100"
             style="background:linear-gradient(135deg,#8b5cf6,#6366f1);">

            <div class="card-body text-white p-4">

                <div class="d-flex justify-content-between align-items-start mb-3">

                    <h5 class="mb-0">
                        Bugün Gelen Rezervasyon
                    </h5>

                    <span class="badge bg-light text-dark">
                        Canlı
                    </span>

                </div>

                <h2 class="fw-bold mb-2">
                    @Model.TodayReservationCount
                </h2>

                <p class="mb-1 text-white-50">

                    Onay Bekleyen:

                    <strong class="text-white">
                        @Model.PendingReservationCount
                    </strong>

                </p>

                <small class="text-white-50">
                    API senkronizasyonu aktif
                </small>

            </div>

        </div>
    </div>

    <div class="col-lg-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <h5 class="mb-4">
                    Bugünkü Operasyon
                </h5>

                <div class="d-flex justify-content-between mb-3">
                    <span>Bugün Teslim</span>
                    <strong>@Model.TodayCheckOutCount</strong>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span>Bugün Dönecek</span>
                    <strong>@Model.TodayReturnCount</strong>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Aktif Kiralama</span>
                    <strong>@Model.ActiveReservationCount</strong>
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <h5 class="mb-4">
                    Canlı Bilgi Paneli
                </h5>

                <div class="d-flex justify-content-between mb-3">

                    <span>Sunucu Saati</span>

                    <strong>
                        @Model.GeneratedAt.ToString("dd.MM.yyyy HH:mm")
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-2">

                    <span>Doluluk Oranı</span>

                    <strong>
                        %@Model.ReservationLoadRate
                    </strong>

                </div>

                <div class="progress mb-3"
                     style="height:8px;">

                    <div class="progress-bar bg-primary"
                         style="width:@Model.ReservationLoadRate%">
                    </div>

                </div>

                <small class="text-muted">
                    Dashboard verileri canlı güncellenmektedir.
                </small>

            </div>

        </div>

    </div>

</div>