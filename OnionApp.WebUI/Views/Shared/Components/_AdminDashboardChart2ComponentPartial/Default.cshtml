
@using OnionApp.WebUI.Models
@model DashboardViewModel

<div class="card h-100 border-0 shadow-sm">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title mb-0">
                Yakıt Dağılımı
            </h5>

            <span class="badge bg-success-subtle text-success">
                Canlı
            </span>
        </div>

        <div style="height:320px;">
            <canvas id="fuelDistributionChart"></canvas>
        </div>

    </div>
</div>

<script>
    (() => {

        const el = document.getElementById("fuelDistributionChart");

        if (!el || typeof Chart === "undefined")
            return;

        new Chart(el, {
            type: "doughnut",

            data: {
                labels: [
                    "Elektrik",
                    "Benzin / Dizel"
                ],

                datasets: [{
                    data: [
                        @Model.ElectricCount,
                        @Model.GasOrDieselCount
                    ],

                    backgroundColor: [
                        "#10b981",
                        "#6366f1"
                    ],

                    borderWidth: 0
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        position: "bottom"
                    }
                },

                cutout: "70%"
            }
        });

    })();
</script>
