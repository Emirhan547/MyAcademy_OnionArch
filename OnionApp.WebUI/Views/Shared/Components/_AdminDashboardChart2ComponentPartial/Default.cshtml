@using OnionApp.WebUI.Models
@model DashboardViewModel


            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Yakıt Dağılımı</h5>
                        <span class="badge badge-soft-success">Canlı</span>
                    </div>
                    <canvas id="fuelDistributionChart" height="180"></canvas>
                </div>
            </div>
       

        <script>
                    (()=>{const el=document.getElementById("fuelDistributionChart"); if(!el||typeof Chart==="undefined")return; new Chart(el,{type:"doughnut",data:{labels:["Elektrik","Benzin/Dizel"],datasets:[{data:[@Model.ElectricCount,@Model.GasOrDieselCount],backgroundColor:["#10b981","#6366f1"]}]},options:{responsive:true}});})();
        </script>