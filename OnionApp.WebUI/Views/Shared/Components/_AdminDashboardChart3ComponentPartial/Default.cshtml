@using OnionApp.WebUI.Models
@model DashboardViewModel


            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Operasyon KPI</h5>
                        <span class="badge badge-soft-warning">Anlık</span>
                    </div>
                    <canvas id="operationKpiChart" height="180"></canvas>
                </div>
            </div>
       

        <script>
                    (()=>{const el=document.getElementById("operationKpiChart"); if(!el||typeof Chart==="undefined")return; new Chart(el,{type:"line",data:{labels:["Toplam Araç","1000km Altı","Otomatik","Blog"],datasets:[{label:"KPI",data:[@Model.CarCount,@Model.UnderThousandKmCount,@Model.AutoTransmissionCount,@Model.BlogCount],borderColor:"#0ea5e9",backgroundColor:"rgba(14,165,233,.2)",fill:true,tension:.35}]},options:{responsive:true,plugins:{legend:{display:false}}}});})();
        </script>