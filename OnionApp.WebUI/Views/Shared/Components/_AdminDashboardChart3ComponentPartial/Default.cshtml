
@using OnionApp.WebUI.Models
@model DashboardViewModel

<div class="card h-100 border-0 shadow-sm">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title mb-0">
                Operasyon KPI
            </h5>

            <span class="badge bg-warning-subtle text-warning">
                Anlık
            </span>
        </div>

        <div style="height:320px;">
            <canvas id="operationKpiChart"></canvas>
        </div>

    </div>
</div>

<script>
    (() => {

        const el = document.getElementById("operationKpiChart");

        if (!el || typeof Chart === "undefined")
            return;

        new Chart(el, {
            type: "line",

            data: {
                labels: [
                    "Toplam Araç",
                    "1000KM Altı",
                    "Otomatik",
                    "Blog"
                ],

                datasets: [{
                    label: "KPI",

                    data: [
                        @Model.CarCount,
                        @Model.UnderThousandKmCount,
                        @Model.AutoTransmissionCount,
                        @Model.BlogCount
                    ],

                    borderColor: "#0ea5e9",
                    backgroundColor: "rgba(14,165,233,.15)",

                    fill: true,
                    tension: .4,
                    borderWidth: 3,
                    pointRadius: 4
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

    })();
</script>
