{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "onionapp-user-logs-{0:yyyy.MM}",
          "autoRegisterTemplate": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://localhost",
    "Audience": "https://localhost",
    "Key": "replace_this_with_a_secure_32+_char_secret_key",
    "ExpireDays": 3
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7274"
    ]
  },
  "InternalServices": {
    "ApiBaseUrl": "https://localhost:7069/api/"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "user.events",
    "RoutingKey": "user.activity"
  },
  "MlNet": {
    "ChurnModelVersion": "churn-v1",
    "RecommendationModelVersion": "recommendation-v1"
  }
}
